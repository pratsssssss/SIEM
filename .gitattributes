# Line endings. The repository stores LF for every text file. Files that run in WSL or on Linux are also checked
# out with LF, whatever core.autocrlf says: a stray carriage return breaks bash, systemd, Python and Vector.
# PowerShell scripts run only on Windows, so they are checked out with CRLF.
* text=auto

# WSL, Linux and cross-platform sources and configuration
*.sh text eol=lf
*.py text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.target text eol=lf
*.conf text eol=lf
*.properties text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.env text eol=lf
*.xml text eol=lf
*.md text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows-only scripts
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.whl binary
*.gz binary
*.tar binary
