{
  "policy": {
    "description": "Deletes Linux event indices 7 days after creation, matching Windows events. Matches nothing else.",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "7d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": [
          "siem-linux-*"
        ],
        "priority": 100
      }
    ]
  }
}