{
  "index_patterns": [
    "siem-attack-path-history-*",
    "siem-attack-path-audit-*"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 0,
        "refresh_interval": "10s",
        "codec": "best_compression"
      }
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "seq": {
          "type": "long"
        },
        "path_id": {
          "type": "keyword"
        },
        "version": {
          "type": "integer"
        },
        "at": {
          "type": "date"
        },
        "at_ms": {
          "type": "date",
          "format": "epoch_millis"
        },
        "ts_ms": {
          "type": "date",
          "format": "epoch_millis"
        },
        "why": {
          "type": "text",
          "index": false
        },
        "summary": {
          "type": "object",
          "enabled": false
        },
        "actor": {
          "type": "keyword"
        },
        "action": {
          "type": "keyword"
        },
        "detail": {
          "type": "object",
          "enabled": false
        },
        "previous": {
          "type": "keyword"
        },
        "hash": {
          "type": "keyword"
        }
      }
    }
  }
}