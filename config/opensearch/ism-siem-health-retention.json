{
  "policy": {
    "description": "Deletes health transition and episode indices 120 days after creation. Indices are monthly, so every record is kept at least 90 days.",
    "default_state": "hot",
    "states": [
      {"name": "hot", "actions": [], "transitions": [{"state_name": "delete", "conditions": {"min_index_age": "120d"}}]},
      {"name": "delete", "actions": [{"delete": {}}], "transitions": []}
    ],
    "ism_template": [{"index_patterns": ["siem-health-transitions-*", "siem-health-episodes-*"], "priority": 100}]
  }
}
