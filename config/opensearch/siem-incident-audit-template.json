{
  "index_patterns": ["siem-incident-audit-*"],
  "priority": 100,
  "template": {
    "settings": {
      "index": {"number_of_shards": 1, "number_of_replicas": 0, "refresh_interval": "10s", "codec": "best_compression"}
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "seq": {"type": "long"},
        "incident_id": {"type": "keyword"},
        "ts_ms": {"type": "date", "format": "epoch_millis"},
        "at": {"type": "date"},
        "actor": {"type": "keyword"},
        "action": {"type": "keyword"},
        "detail": {"type": "object", "enabled": false},
        "previous": {"type": "keyword"},
        "hash": {"type": "keyword"}
      }
    }
  }
}
