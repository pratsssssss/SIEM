{
  "policy": {
    "description": "Deletes SIEM event and dead-letter indices seven days after creation. Matches nothing else.",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [{"state_name": "delete", "conditions": {"min_index_age": "7d"}}]
      },
      {
        "name": "delete",
        "actions": [{"delete": {}}],
        "transitions": []
      }
    ],
    "ism_template": [{"index_patterns": ["siem-windows-*", "siem-deadletter-*"], "priority": 100}]
  }
}
