# Site settings: the paths that differ between machines. The WSL installers read this file, then
# config/wsl/site.local.env if it exists. Copy this file to site.local.env and set the values for your machine.
# site.local.env is listed in .gitignore, so your own paths are never committed.
#
# Each value is a Windows folder as WSL sees it, under the Windows profile of the person who runs the Windows agent.

# Where the WSL services publish small status reports, which the Windows alert watcher reads.
SIEM_WINDOWS_MONITOR='/mnt/c/Users/<windows-user>/SIEM-Lab/monitor'

# Where the Windows asset collector drops its snapshots, which the asset service reads.
SIEM_WINDOWS_INVENTORY='/mnt/c/Users/<windows-user>/SIEM-Lab/inventory'
